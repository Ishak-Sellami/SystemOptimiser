<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مركز الصلاحيات"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:gravity="center"
            android:text="الخطوات: منح صلاحيات التشغيل ثم (اختيارياً) الصلاحيات الخاصة ثم الضغط على تشغيل."
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/pc_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/pc_btn_runtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="منح الصلاحيات المطلوبة"
            android:textSize="16sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/pc_btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="العرض فوق التطبيقات (الإعدادات)"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/pc_btn_write_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعديل إعدادات النظام (الإعدادات)"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/pc_btn_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حالة إدارة الجهاز والجلسة (تشخيص)"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/pc_btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تشغيل الخدمة"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="22dp"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>