<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_security_lock">

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#3B82F6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/block_icon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="Security Lock"
            android:src="@drawable/ic_security_lock"
            android:tint="#3B82F6"
            android:alpha="0.92" />

        <TextView
            android:id="@+id/block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.12"
            android:text="SECURITY LOCK"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.06"
            android:text="SCREEN LOCK ACTIVE"
            android:textColor="#60A5FA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/block_countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="monospace"
            android:textColor="#3B82F6"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LOCK WILL AUTO-RELEASE WHEN TIMER ENDS"
            android:textColor="#8A93A6"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0E1526"
        android:gravity="center"
        android:padding="10dp"
        android:text="SUPERVISED DEVICE  •  SYSTEM CONTROL  •  SESSION PROTECTED"
        android:textColor="#4B5563"
        android:textSize="10sp"
        android:letterSpacing="0.1" />
</LinearLayout>