<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- الشبكة والاتصال -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- الخدمة في المقدمة -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- الاستقبال عند الإقلاع -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- واجهة المستخدم والنظام -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- قراءة الصور لتغيير الخلفية (مع Scoped Storage) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- صلاحيات حساسة تُطلب وقت التشغيل -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- النشاط الرئيسي (المشغّل) -->
        <activity android:name=".MainActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:screenOrientation="portrait"
            android:exported="true"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- شاشة منح صلاحيات الروت (داخلية، تُفتح من التطبيق فقط) -->
        <activity android:name=".RootPermissionActivity"
            android:theme="@style/AppTheme"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- مركز الصلاحيات (شاشة الإعداد الأولي، بدون root) -->
        <activity android:name=".PermissionCenterActivity"
            android:theme="@style/AppTheme"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- حجب الشاشة المؤقت -->
        <activity android:name=".BlockScreenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- مشغل الفيديو بملء الشاشة -->
        <activity android:name=".VideoPlayerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- رسالة التحذير الجادة -->
        <activity android:name=".SeriousWarningActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- نشاط الشاشة السوداء -->
        <activity android:name=".BlackScreenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- نشاط رسائل التحذير -->
        <activity android:name=".MessageDashboardActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- نشاط التقاط الصورة -->
        <activity android:name=".CameraCaptureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- تشخيصات إدارة الجهاز وحالة جلسة الحجب الصارمة -->
        <activity android:name=".ManagementDiagnosticsActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:screenOrientation="portrait" />

        <!-- مستقبل إدارة الأجهزة (Device Owner) لحجب الشاشة -->
        <receiver android:name=".DeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- مزود الملفات لنشاط الكاميرا -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.systemoptimizer.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- الخدمة الخلفية -->
        <service android:name=".BackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- مستقبل بدء التشغيل/الإقلاع وإعادة استعادة جلسة الحجب بعد الإقلاع -->
        <receiver android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- مستقبل مؤشرات جلسة الحجب (تشغيل مجدول / انتهاء) -->
        <receiver android:name=".BlockSessionAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- مستقبل الشاشة السوداء عند بدء التشغيل -->
        <receiver android:name=".BlackScreenBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>